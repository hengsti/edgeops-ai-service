# rules | ml
PREDICTION_BACKEND=rules
MODEL_ARTIFACT_PATH=artifacts/model.onnx
MODEL_ARTIFACT_SHA256=

COLLECTOR_API_KEY=local-dev-key
COLLECTOR_POLLING_ENABLED=true
COLLECTOR_POLL_INTERVAL_SECONDS=10
COLLECTOR_TIMEOUT_SECONDS=3
# Comma-separated device IDs for heartbeat checks
COLLECTOR_DEVICE_IDS=

# Optional Advisor: uncomment URL and read-only token together to enable /v1/state-report.
# ADVISOR_INFLUX_URL=http://influxdb:8086
# ADVISOR_INFLUX_ORG=smarthome
# ADVISOR_INFLUX_TOKEN=your-read-only-token
# ADVISOR_REFRESH_SECONDS=300

# Optional outdoor weather for Advisor ventilation advice (OpenWeatherMap Current Weather).
# Set both values to enable; postcode includes the two-letter country code.
# ADVISOR_WEATHER_POSTCODE=1030,AT
# ADVISOR_WEATHER_API_KEY=your-openweathermap-api-key
